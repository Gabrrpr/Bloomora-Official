# Production backend
EXPO_PUBLIC_API_URL=https://api.estings.shop/api/v1
EXPO_PUBLIC_MOBILE_CONTENT_MODE=api

# Web map reverse geocoding. Native builds use the backend reverse-geocode
# proxy (or the device geocoder when available), avoiding unreliable direct
# requests from Expo Go to the public Nominatim endpoint.
EXPO_PUBLIC_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# OpenStreetMap-derived, API-key-free vector map style used by MapLibre Native.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Must match the backend FRONTEND_URL because OAuth redirects there before mobile exchanges the code.
EXPO_PUBLIC_WEB_URL=https://blueviolet-otter-621683.hostingersite.com

# Local web frontend, for local OAuth testing:
# EXPO_PUBLIC_WEB_URL=http://localhost:5173

# Local backend, for physical devices on the same Wi-Fi:
# EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:8000/api/v1
#
# Local/LAN URLs are for development only. Expo inlines EXPO_PUBLIC_* values at
# build/start time, while Developer Tools can also save a runtime API URL
# override on the device. Use Developer Tools > Backend Connection > Reset if a
# device keeps using an old API URL after changing env files.

# Android emulator local backend:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

# iOS simulator local backend:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
