{
  "cli": {
    "version": ">= 18.9.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.estings.shop/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://estings.shop"
      }
    },
    "apk": {
      "channel": "apk",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.estings.shop/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://estings.shop"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.estings.shop/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://estings.shop"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
